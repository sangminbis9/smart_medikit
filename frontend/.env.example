# 모두 공개 설정입니다. 비밀키나 토큰을 입력하지 마세요.
# 비워 두면 API 없이 빈 보관함과 선택형 시연 모드로 실행합니다.
VITE_API_URL=
# 별도 복용약 API 주소입니다. 비밀번호나 AWS 비밀키는 넣지 마세요.
VITE_MEDICATION_API_URL=
# 누구나 복용약 목록을 조회·수정·삭제하는 공개 시연을 승인한 경우에만 true로 설정한다.
VITE_MEDICATION_PUBLIC_DEMO=false
VITE_WS_URL=
VITE_BOX_ID=
# 보관함 내부 치수(mm). 세 값을 모두 입력하기 전에는 예시 비율을 사용합니다.
VITE_BOX_WIDTH=
VITE_BOX_DEPTH=
VITE_BOX_HEIGHT=
